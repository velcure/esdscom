<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="urn:test" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:test" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.0">
	<xs:element name="Root">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Colour" type="t:Colour"/>
				<xs:element name="Code" type="t:Code"/>
				<xs:element name="Fixed" type="t:Fixed"/>
				<xs:element name="Name" type="t:Name"/>
				<xs:element name="Percent" type="t:Percent"/>
				<xs:element name="Share" type="t:Share"/>
				<xs:element name="Token" type="t:Token"/>
				<xs:element name="Narrow" type="t:Narrow"/>
				<xs:element name="Small">
					<xs:simpleType>
						<xs:restriction base="xs:integer">
							<xs:minInclusive value="1"/>
							<xs:maxInclusive value="9"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Anon" type="t:Anon"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="Colour">
		<xs:annotation>
			<xs:documentation>A colour.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="string">
			<xs:enumeration value="red">
				<xs:annotation>
					<xs:documentation>Like blood.</xs:documentation>
				</xs:annotation>
			</xs:enumeration>
			<xs:enumeration value="light-blue"/>
			<xs:enumeration value="Weight-%"/>
			<xs:enumeration value="a b"/>
			<xs:enumeration value="a.b"/>
			<xs:enumeration value=""/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Code">
		<xs:restriction base="xs:string">
			<xs:pattern value="\d{2,7}-\d{2}-\d"/>
			<xs:pattern value="[-.\w]+@x"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Fixed">
		<xs:restriction base="string">
			<xs:length value="4"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Name">
		<xs:restriction base="string">
			<xs:minLength value="1"/>
			<xs:maxLength value="64"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Percent">
		<xs:restriction base="xs:float">
			<xs:minInclusive value="0"/>
			<xs:maxInclusive value="100"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Share">
		<xs:restriction base="xs:decimal">
			<xs:totalDigits value="6"/>
			<xs:fractionDigits value="3"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Token">
		<xs:restriction base="string">
			<xs:whiteSpace value="collapse"/>
			<xs:pattern value="[A-Z]+"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Narrow">
		<xs:restriction base="t:Colour">
			<xs:enumeration value="red"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="Anon">
		<xs:restriction>
			<xs:simpleType>
				<xs:restriction base="xs:boolean"/>
			</xs:simpleType>
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
