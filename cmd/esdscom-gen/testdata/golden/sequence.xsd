<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="urn:test" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:test" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.0">
	<xs:element name="Root">
		<xs:annotation>
			<xs:documentation>The root element.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Required" type="string"/>
				<xs:element name="Optional" type="xs:boolean" minOccurs="0"/>
				<xs:element name="Repeated" type="xs:integer" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element name="Bounded" type="xs:float" minOccurs="2" maxOccurs="5"/>
				<xs:element name="When" type="date"/>
				<xs:element name="At" type="dateTime" minOccurs="0"/>
				<xs:element name="Amount" type="decimal" minOccurs="0"/>
				<xs:element name="Count" type="int" minOccurs="0"/>
				<xs:element name="Link" type="anyURI" minOccurs="0"/>
				<xs:element name="Child" type="t:Child" minOccurs="0"/>
				<xs:sequence minOccurs="0">
					<xs:element name="Nested" type="string"/>
				</xs:sequence>
				<xs:sequence maxOccurs="unbounded">
					<xs:element name="Key" type="string"/>
					<xs:element name="Value" type="string" minOccurs="0"/>
				</xs:sequence>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="Child">
		<xs:sequence>
			<xs:element name="Inline">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Leaf" type="string"/>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Self" type="t:Child" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
