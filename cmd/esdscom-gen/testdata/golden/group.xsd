<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="urn:test" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:test" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.0">
	<xs:group name="Pair">
		<xs:annotation>
			<xs:documentation>Two values.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Left" type="string"/>
			<xs:element name="Right" type="string" minOccurs="0"/>
		</xs:sequence>
	</xs:group>
	<xs:group name="Either">
		<xs:choice>
			<xs:element name="Yes" type="string"/>
			<xs:element name="No" type="string"/>
		</xs:choice>
	</xs:group>
	<xs:element name="Root">
		<xs:complexType>
			<xs:sequence>
				<xs:group ref="t:Pair"/>
				<xs:element name="Holder" type="t:Holder"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="Holder">
		<xs:sequence>
			<xs:group ref="t:Pair" minOccurs="0" maxOccurs="3"/>
			<xs:group ref="t:Either"/>
			<xs:choice>
				<xs:group ref="t:Pair"/>
				<xs:element name="Other" type="string"/>
			</xs:choice>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
